# Caddy terminates TLS on the origin, with Cloudflare proxying in front.
#
# Cloudflare's SSL mode must be "Full (strict)" — in "Flexible" it would talk
# plain HTTP to this origin, and every password and session cookie would cross
# the public internet in the clear while the browser still shows a padlock.

{$DOMAIN} {
	encode zstd gzip

	# Cloudflare is the only thing that should reach this origin, so the client
	# IP arrives in CF-Connecting-IP. Without this every OTP request looks like
	# it came from Cloudflare and the per-IP rate limit becomes a global one.
	request_header X-Forwarded-For {header.CF-Connecting-IP}

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
