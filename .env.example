# Phase 1 — required
# connect_timeout=30 gives Neon's free tier room to wake from idle suspend.
# Without it, the first request after a quiet period fails mid-handshake.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require&connect_timeout=30"
JWT_SECRET=                # 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`

# Which SMS driver delivers OTPs. Required explicitly in production.
# "console" logs the code to the server log instead of texting it — fine for a
# demo, unusable for real customers.
SMS_DRIVER=

# Phase 1 — not read by any code yet. They are wired in when the msg91 driver
# is written and 'msg91' is added to SMS_DRIVERS in src/lib/env.ts.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Phase 2 — Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 5 — Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Phase 6 — Telegram order alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Phase 7 — WhatsApp float button
NEXT_PUBLIC_WHATSAPP_NUMBER=
