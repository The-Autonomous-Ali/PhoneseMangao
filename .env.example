# ---------------------------------------------------------------------------
# Core — required everywhere. The app refuses to boot without these.
# ---------------------------------------------------------------------------
# Postgres runs on the same box as the app in production (see docker-compose.yml).
# The connect_timeout below is only needed for a managed free tier that idles
# down, such as Neon; drop it once you are on the Oracle instance.
DATABASE_URL="postgresql://user:password@localhost:5432/phonesemangao"
JWT_SECRET=                # 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`

# Public origin, no trailing slash. Required in production: the Google OAuth
# redirect URI is built from it, and Google matches that URI byte for byte.
APP_URL=https://yourdomain.in

# ---------------------------------------------------------------------------
# Google sign-in — required in production. This is the primary customer login.
# Register `${APP_URL}/api/auth/google/callback` as an authorized redirect URI
# in Google Cloud Console → Credentials → OAuth 2.0 Client ID.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OTP delivery. "console" logs the code to the server log instead of sending it
# — fine for a demo, unusable for real customers. Required explicitly in
# production. Set to "whatsapp" and the three WHATSAPP_* values below become
# required too, so a half-configured deploy fails at boot rather than at login.
# ---------------------------------------------------------------------------
SMS_DRIVER=

WHATSAPP_PHONE_NUMBER_ID=          # Meta → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=             # System User token. NOT the dashboard token, which expires in 24h.
WHATSAPP_AUTH_TEMPLATE_NAME=       # Template registered under the Authentication category, not Utility

# Owner alerts on a new order. Both optional, unlike the three above: the
# Utility template has to clear Meta's review before it exists, and a pending
# approval must not stop the shop booting on OTP settings that already work.
# A missing value skips the alert with a warning.
#
# The template is Utility category with five body parameters, in this order:
#   {{1}} order number   {{2}} customer name   {{3}} phone
#   {{4}} slot           {{5}} summary
# See docs/superpowers/specs/2026-08-10-owner-alerts-and-dashboard-design.md
WHATSAPP_ALERT_TEMPLATE_NAME=
WHATSAPP_OWNER_NUMBER=             # owner alerts, digits only with country code

# ---------------------------------------------------------------------------
# Cron. The host crontab sends this as an x-cron-secret header; without it the
# job routes are open to anyone who can reach the app. Required in production.
# ---------------------------------------------------------------------------
CRON_SECRET=                       # 16+ characters

# ---------------------------------------------------------------------------
# Product and category images. "local" writes into public/uploads — fine on a
# developer's machine, and rejected at boot in production, where the container
# filesystem is ephemeral and every upload would vanish on the next restart.
# Set to "cloudinary" and the three values below become required.
# ---------------------------------------------------------------------------
IMAGE_DRIVER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Razorpay. All three must be set together — keys without a webhook secret
# means payments are taken and never confirmed, since the webhook is the only
# thing that marks an order paid. The app refuses to boot on a half-set.
#
# Having the keys is not enough to switch payments on: that is the
# `payments_enabled` row in Settings, so a shop can launch cash-only and turn
# online payment on later without a deploy.
#
# Register the webhook in the Razorpay dashboard against
# ${APP_URL}/api/webhooks/razorpay for payment.captured and payment.failed.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Phase 6 — Telegram order alerts
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---------------------------------------------------------------------------
# Phase 7 — WhatsApp float button (the shop's public number, not the API number)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
